<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Configurations>Debug;Release;Tracy</Configurations>
    <Platforms>AnyCPU</Platforms>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Resonalyze</AssemblyName>
    <RootNamespace>Resonalyze</RootNamespace>
    <AssemblyTitle>Resonalyze</AssemblyTitle>
    <Company>DIMOSUS</Company>
    <Product>Resonalyze</Product>
    <VersionPrefix>0.0.0</VersionPrefix>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationIcon>logo.ico</ApplicationIcon>
    <SparklePublicKey Condition="'$(SparklePublicKey)' == ''"></SparklePublicKey>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Tracy'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>portable</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>$(DefineConstants);TRACE;TRACY_ENABLE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="logo.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bundled so the tuning-sheet PDF banner works without a filesystem path. -->
    <EmbeddedResource Include="..\assets\images\banner_white.jpg" LogicalName="Resonalyze.banner.jpg" />
  </ItemGroup>

  <ItemGroup Condition="'$(SparklePublicKey)' != ''">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>SparklePublicKey</_Parameter1>
      <_Parameter2>$(SparklePublicKey)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
    <!-- NAudio is a transitive dependency via Resonalyze.Audio; the application
         no longer references it directly, so a stray `using NAudio` here fails
         to compile — the audio boundary is enforced by the build. -->
    <PackageReference Include="NetSparkleUpdater.UI.WinForms" Version="3.0.1" />
    <PackageReference Include="OxyPlot.WindowsForms" Version="2.2.0" />
    <PackageReference Include="PDFsharp-MigraDoc-GDI" Version="6.2.4" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Tracy'">
    <PackageReference Include="Tracy-CSharp" Version="0.13.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\dsp\Resonalyze.Dsp.csproj" />
    <ProjectReference Include="..\audio\Resonalyze.Audio.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The audio-driver library lives in its own namespace; a global using keeps
         the many existing call sites compiling without a per-file using. -->
    <Using Include="Resonalyze.Audio" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Single-file publish targets live here, not in the .pubxml: Visual Studio reads a profile's properties only. -->
  <!-- build.yml's version rule: tag vX.Y.Z plus N commits is X.Y.(Z+1)-dev.N. Skipped when -p:Version is given. -->
  <!-- A prerelease tag vX.Y.Z-rc.1 plus N commits is X.Y.Z-rc.1.dev.N: after that prerelease, before the release. -->
  <Target Name="VersionFromGitTag" BeforeTargets="GetAssemblyVersion"
          Condition="'$(PublishSingleFile)' == 'true' and '$(Version)' == '$(VersionPrefix)'">
    <Exec Command="git describe --tags --match &quot;v*&quot; --long"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          ConsoleToMSBuild="true"
          StandardOutputImportance="low"
          IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitDescribe" />
      <Output TaskParameter="ExitCode" PropertyName="_GitDescribeExitCode" />
    </Exec>
    <PropertyGroup>
      <_GitVersionPattern>^v(\d+\.\d+)\.(\d+)(-[0-9A-Za-z.-]+)?-(\d+)-g[0-9a-f]+$</_GitVersionPattern>
      <_GitVersionFound>false</_GitVersionFound>
      <_GitVersionFound Condition="'$(_GitDescribeExitCode)' == '0' and $([System.Text.RegularExpressions.Regex]::IsMatch('$(_GitDescribe)', '$(_GitVersionPattern)'))">true</_GitVersionFound>
    </PropertyGroup>
    <PropertyGroup Condition="'$(_GitVersionFound)' == 'true'">
      <_GitMajorMinor>$([System.Text.RegularExpressions.Regex]::Replace('$(_GitDescribe)', '$(_GitVersionPattern)', '$1'))</_GitMajorMinor>
      <_GitPatch>$([System.Text.RegularExpressions.Regex]::Replace('$(_GitDescribe)', '$(_GitVersionPattern)', '$2'))</_GitPatch>
      <_GitPrerelease>$([System.Text.RegularExpressions.Regex]::Replace('$(_GitDescribe)', '$(_GitVersionPattern)', '$3'))</_GitPrerelease>
      <_GitCommits>$([System.Text.RegularExpressions.Regex]::Replace('$(_GitDescribe)', '$(_GitVersionPattern)', '$4'))</_GitCommits>
      <Version Condition="'$(_GitCommits)' == '0'">$(_GitMajorMinor).$(_GitPatch)$(_GitPrerelease)</Version>
      <Version Condition="'$(_GitCommits)' != '0' and '$(_GitPrerelease)' == ''">$(_GitMajorMinor).$([MSBuild]::Add($(_GitPatch), 1))-dev.$(_GitCommits)</Version>
      <Version Condition="'$(_GitCommits)' != '0' and '$(_GitPrerelease)' != ''">$(_GitMajorMinor).$(_GitPatch)$(_GitPrerelease).dev.$(_GitCommits)</Version>
    </PropertyGroup>
    <Warning Condition="'$(_GitVersionFound)' != 'true'"
             Text="No vX.Y.Z tag found by git describe ('$(_GitDescribe)'); the exe keeps version $(Version)." />
    <Message Importance="high" Text="Resonalyze version: $(Version)" />
  </Target>

  <!-- DebugType=None reaches only this project; the libraries' .pdb, which release.yml deletes, are never copied. -->
  <Target Name="DropReferenceSymbols" AfterTargets="ComputeResolvedFilesToPublishList"
          Condition="'$(PublishSingleFile)' == 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

</Project>
